[Public]
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=AntialiasMode,Title="Anti Aliasing Mode",Description="Anti alias method used to reduce jagged edges.",Value("Off"),Value("MSAA_2x"),Value("MSAA_4x"))
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=LightMode,Title="Light Mode",Description="Adjust how map surfaces and actors are lit. One-X Blending applies lightmaps at 1x instead of 2x, like the original DirectX 7 renderer. Brighter Actors lights solid meshes 1.5x brighter.",Value("Normal"),Value("OneXBlending=One-X Blending"),Value("BrighterActors=Brighter Actors"))
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=UseVSync,Title="Vertical Sync (VSync)",Description="If checked, frames are synchronized with the monitor refresh rate to prevent screen tearing. Disabling it can increase frame rates and reduce input latency.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=UsePrecache,Title="Precaching",Description="If checked, all textures will be precached in GPU memory. This increases load times, but reduces fluctuations in the frame rate.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=DetailTextures,Title="Detail Textures",Description="If checked, enables detail texture support.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=HighDetailActors,Title="High Detail Actors",Description="If enabled, high-detail version of specific objects will be used. Disabling this might improve performance but significantly reduce image quality.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=Coronas,Title="Coronas",Description="If checked, enables rendering of light coronas.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=ShinySurfaces,Title="Shiny Surfaces",Description="Enables rendering of shiny surfaces such as mirrors.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=VolumetricLighting,Title="Volumetric Lighting",Description="Enables rendering of volumetric light effects such as fog.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=Hdr,Title="HDR Mode",Description="Enables using high dynamic range. Only works if your monitor is set to run in HDR mode.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=HdrScale,Title="HDR Scale",Description="Adjust HDR brightness multiplier.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=Bloom,Title="Bloom",Description="If checked, blooms overbright pixels.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=BloomAmount,Title="Bloom Amount",Description="Sets the amount of blooming for overbright pixels.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=LinearBrightness,Title="Linear Brightness",Description="Adjust brightness for all pixels. 128 leaves the brightness unchanged.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=Contrast,Title="Contrast",Description="Adjusts pixel contrast. 128 leaves the contrast unchanged.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=Saturation,Title="Saturation",Description="Adjusts how saturated the colors are. 255 shows the full colors, 0 shows grayscale.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GrayFormula,Title="Gray Formula",Description="Chooses how the gray level of a pixel is calculated for Contrast and Saturation: the plain average of its color channels, a weighted average, or its true luminance. Only used if Linear Brightness, Contrast or Saturation are changed.",Value("0=Average"),Value("1=Weighted"),Value("2=Luminance"))

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaMode,Title="Gamma Mode",Description="Chooses what gamma calculation algorithm to use: the one of the D3D9 renderer, or the one of XOpenGL.",Value("D3D9"),Value("XOpenGL"))
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaOffset,Title="Gamma Offset",Description="Offsets the normal brightness option. Positive values will make the image brighter, negatives will make it darker.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaOffsetRed,Title="Gamma Offset Red",Description="Offsets the normal brightness option on the red channel. Positive values will make red tints brighter, negatives will make them darker.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaOffsetGreen,Title="Gamma Offset Green",Description="Offsets the normal brightness option on the green channel. Positive values will make green tints brighter, negatives will make them darker.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaOffsetBlue,Title="Gamma Offset Blue",Description="Offsets the normal brightness option on the blue channel. Positive values will make blue tints brighter, negatives will make them darker.")
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=GammaCorrectScreenshots,Title="Gamma Correct Screenshots",Description="If checked, saved screenshots will have current gamma correction settings applied to them.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=LODBias,Title="Texture LOD Bias",Description="Controls the distance at which surfaces and objects switch to lower-detail textures. Negative values increase the overall detail, while positive values decrease it. We recommend keeping the default setting.")

Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=VkDeviceIndex,Title="Vulkan Device",Description="Selects the GPU to render with on systems that have more than one. Type GetVkDevices in the console to list the available devices and their numbers.",RequireRestart)
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=VkExclusiveFullscreen,Title="Exclusive Fullscreen",Description="If checked, fullscreen mode takes exclusive control of the display. This can reduce input latency, but makes switching to other windows slower.",RequireRestart)
Property=(Config,Class=VulkanDrv.VulkanRenderDevice,Name=VkDebug,Title="Vulkan Debug",Description="If checked, enables the Vulkan validation layer, which checks all rendering commands for errors and reports them to the log. This greatly reduces performance and only works if the Vulkan SDK is installed.",RequireRestart)
